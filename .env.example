# === Base de données ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=insa_sports
# Attention : l'hôte est "postgres" (nom du service Docker), pas "localhost"
DATABASE_URL=postgresql://admin:change_me@postgres:5432/insa_sports?schema=public

# === WebSocket ===
# URL publique du serveur WebSocket (port 3002 car Docker Desktop occupe le 3001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# === Redis ===
# Attention : l'hôte est "redis" (nom du service Docker), pas "localhost"
REDIS_URL=redis://redis:6379

# === Domaine email autorisé par défaut (ajouté au premier démarrage) ===
DEFAULT_EMAIL_DOMAIN=insa-cvl.fr
DEFAULT_SCHOOL_NAME=INSA Centre Val de Loire

# === NextAuth ===
# URL publique de l'application (ex: http://localhost:3000 en local)
NEXTAUTH_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# === Email (SMTP) ===
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=user@example.com
EMAIL_SERVER_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@example.com

# === LyfPay (optionnel) ===
LYFPAY_API_URL=https://payment-api.lyf.eu
LYFPAY_CLIENT_ID=
LYFPAY_CLIENT_SECRET=
LYFPAY_MERCHANT_ID=
